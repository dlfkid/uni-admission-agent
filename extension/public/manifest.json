{
    "manifest_version": 3,
    "name": "UniAdmission Agent",
    "version": "0.4.5-alpha-1-ge18c51d",
    "description": "Send the current page URL to UniAdmission Agent for crawling.",
    "permissions": [
        "activeTab"
    ],
    "host_permissions": [
        "http://localhost:8910/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "UniAdmission Agent"
    },
    "icons": {
        "128": "icons/icon128.png"
    }
}