# ----------------------------------------------------------------------
# Database — optional (SQLite is the default, zero install required)
# ----------------------------------------------------------------------
#
# Option A — SQLite (default, recommended)
#   Leave DATABASE_URL unset / commented out. On first start, a local
#   file is created automatically:
#     • Dev (`uv run` from source):  ./data/admission.db
#     • Packaged binary:             ~/.uni-agent/admission.db    (macOS/Linux)
#                                    %USERPROFILE%\.uni-agent\admission.db  (Windows)
#   PRAGMAs applied per connection: WAL, busy_timeout=5000,
#   foreign_keys=ON, synchronous=NORMAL.
#   ⚠️  Avoid putting the .db file under iCloud / OneDrive / Dropbox —
#       sync can corrupt SQLite. The defaults above are sync-safe.
#   ⚠️  Local disk only — SQLite locking is unreliable on SMB/NFS.
#
# Option B — Postgres (advanced)
#   Uncomment the line below and set credentials. Requires `psycopg2-binary`
#   to be installed (already pinned in pyproject.toml). Alembic migrations
#   run automatically on first start.
#     DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/uni_admission
#
# Switching engines: change DATABASE_URL and restart. There is no data
# copy — each engine keeps its own state. If you want to move data, use
# the export/import REST endpoints.
# DATABASE_URL=

# Gemini APIKey config
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.0-flash

# DeepSeek APIKey config
# Get your key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-chat

# VolcEngine (豆包) config
# Get your credentials from: https://console.volcengine.com/ark/region:ark+cn-beijing/endpoint
VOLC_API_KEY=your_volc_api_key_here
VOLC_MODEL_ID=your_model_endpoint_id
# VOLC_REGION=cn-beijing
# VOLC_PROJECT_NAME=default
# VOLC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Custom LLM config (OpenAI-compatible)
CUSTOM_LLM_BASE_URL=your_base_url_here
CUSTOM_LLM_API_KEY=your_api_key_here
CUSTOM_LLM_MODEL_NAME=your_model_name_here

# LLM Priority config
# Comma-separated list of providers to try in order
LLM_PRIORITY_LIST=deepseek, gemini, volcengine
